# DNA Stitches — environment variables (PRD §9).
# Copy to `.env` for local development: `cp .env.example .env`
# Never commit real secrets. `.env*` files other than this one are git-ignored.
#
# Validation lives in src/lib/env.schema.ts. Variables marked [prod] are
# optional in development but REQUIRED when NODE_ENV=production (incl. `next build`).

# ── Database (Neon or Supabase Postgres) ────────────────────────────────────
# Local example: postgresql://postgres:postgres@localhost:5432/dnastitches
DATABASE_URL=

# ── Auth.js v5 ───────────────────────────────────────────────────────────────
# Required everywhere. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Optional: Google OAuth (both or neither). Redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# [prod] Resend API key used to send magic-link sign-in emails
AUTH_RESEND_KEY=
# Comma-separated emails that are granted the ADMIN role on sign-in / seed
ADMIN_EMAILS=

# ── File storage (Vercel Blob) ───────────────────────────────────────────────
# [prod]
BLOB_READ_WRITE_TOKEN=

# ── Payments (Paystack) ──────────────────────────────────────────────────────
# [prod] sk_test_… / sk_live_… — also used to verify webhook signatures
PAYSTACK_SECRET_KEY=
# [prod] pk_test_… / pk_live_…
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Default deposit as a percentage of a custom-order quote (0–100)
DEPOSIT_PERCENT=50
# Days after handover during which defects can be reported for free repair (D-13)
REPAIR_WINDOW_DAYS=7

# ── Email (Resend + React Email) ─────────────────────────────────────────────
# [prod]
RESEND_API_KEY=
# [prod] e.g. "DNA Stitches <hello@yourdomain.com>" (domain must be verified in Resend)
EMAIL_FROM=

# ── Cron (v1.1) ──────────────────────────────────────────────────────────────
CRON_SECRET=

# ── App ──────────────────────────────────────────────────────────────────────
# [prod] Public base URL, e.g. https://dnastitches.com (defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STUDIO_TIMEZONE=Africa/Lagos
DEFAULT_CURRENCY=NGN
MIN_LEAD_TIME_DAYS=14
